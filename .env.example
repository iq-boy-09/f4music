# --- Required ---------------------------------------------------------------
API_ID=your_api_id
API_HASH=your_api_hash
BOT_TOKEN=your_botfather_token

# --- Sessions ---------------------------------------------------------------
BOT_SESSION=command_bot_live
ASSISTANT_SESSION=voice_assistant_8896291170
ASSISTANT_PHONE=
ASSISTANT_USER_ID=
ASSISTANT_USERNAME=
# Set to false to stay logged in between runs (no new login code each start)
CLEANUP_SESSIONS_ON_EXIT=true

# --- Access -----------------------------------------------------------------
# Comma-separated Telegram user IDs: can always use player controls and /broadcast
OWNER_IDS=
# Higher-trust owners; these are also allowed to broadcast.
SUPEROWNER_IDS=
# Optional chat that receives the menu when the bot starts
STARTUP_CHAT_ID=

# --- Features ---------------------------------------------------------------
# Allow /send, /video and private-chat downloads (only for media you may download)
PRIVATE_DOWNLOADS=false
# If voice playback fails in a group, send the track as an MP3 instead (needs PRIVATE_DOWNLOADS=true)
GROUP_AUDIO_FALLBACK=true
MAX_QUEUE=10
# Longest allowed track in minutes (0 = no limit)
MAX_DURATION_MINUTES=60
DEFAULT_VOLUME=100
# Simultaneous downloads and per-user delay between heavy commands
DOWNLOAD_SLOTS=2
COOLDOWN_SECONDS=3

# --- YouTube ----------------------------------------------------------------
# Netscape-format cookies.txt, helps when YouTube asks to "confirm you're not a bot"
COOKIES_FILE=
# Or load cookies directly from a logged-in browser: chrome, edge, firefox, brave, ...
# Keep the browser closed while yt-dlp reads its cookie database.
COOKIES_FROM_BROWSER=

# --- Misc -------------------------------------------------------------------
STATE_DB=musicbot.sqlite3
DOWNLOAD_DIR=downloads
LOG_LEVEL=INFO
